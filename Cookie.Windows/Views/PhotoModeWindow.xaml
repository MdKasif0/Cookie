<Window x:Class="Cookie.Windows.Views.PhotoModeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Photo Mode"
        Width="540" Height="720"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        ThemeMode="System"
        FontSize="13">

    <StackPanel Margin="22,18,22,18">
        <Border Width="260" Height="260" CornerRadius="16" BorderThickness="1" ClipToBounds="True"
                BorderBrush="{DynamicResource BorderSubtle}" HorizontalAlignment="Center">
            <Grid>
                <!-- A checkerboard, so a clear backdrop reads as clear. -->
                <Rectangle>
                    <Rectangle.Fill>
                        <DrawingBrush TileMode="Tile" Viewport="0,0,24,24" ViewportUnits="Absolute">
                            <DrawingBrush.Drawing>
                                <DrawingGroup>
                                    <GeometryDrawing Brush="{DynamicResource BgIvory}">
                                        <GeometryDrawing.Geometry>
                                            <RectangleGeometry Rect="0,0,24,24"/>
                                        </GeometryDrawing.Geometry>
                                    </GeometryDrawing>
                                    <GeometryDrawing Brush="{DynamicResource BgCream}">
                                        <GeometryDrawing.Geometry>
                                            <GeometryGroup>
                                                <RectangleGeometry Rect="0,0,12,12"/>
                                                <RectangleGeometry Rect="12,12,12,12"/>
                                            </GeometryGroup>
                                        </GeometryDrawing.Geometry>
                                    </GeometryDrawing>
                                </DrawingGroup>
                            </DrawingBrush.Drawing>
                        </DrawingBrush>
                    </Rectangle.Fill>
                </Rectangle>
                <Image x:Name="PreviewImage" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"
                       AutomationProperties.Name="Preview of Cookie"/>
            </Grid>
        </Border>

        <TextBlock Text="Pose" FontWeight="SemiBold" Margin="0,16,0,6"/>
        <WrapPanel x:Name="PosePanel"/>

        <Grid Margin="0,14,0,0">
            <TextBlock Text="Backdrop" FontWeight="SemiBold" VerticalAlignment="Center"/>
            <StackPanel x:Name="BackdropPanel" Orientation="Horizontal" HorizontalAlignment="Right"/>
        </Grid>

        <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
            <Button x:Name="SavePngButton" Content="Save PNG..." Click="SavePng_Click" Margin="0,0,8,0" AutomationProperties.Name="Save as PNG"/>
            <Button x:Name="SaveGifButton" Content="Save GIF..." Click="SaveGif_Click" Margin="0,0,8,0" AutomationProperties.Name="Save as GIF"/>
            <Button x:Name="CopyButton" Content="Copy" Click="Copy_Click" AutomationProperties.Name="Copy image"/>
        </StackPanel>

        <TextBlock x:Name="StatusText" Foreground="{DynamicResource TextMuted}" FontSize="12" Margin="0,10,0,0" TextWrapping="Wrap"/>
        <TextBlock x:Name="GifNote" Foreground="{DynamicResource TextMuted}" FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap"
                   Text="A transparent GIF has hard edges. Pick a backdrop color for the smoothest result."/>
    </StackPanel>
</Window>
