<Window x:Class="Cookie.Windows.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:rendering="clr-namespace:Cookie.Windows.Rendering"
        Title="Cookie Settings"
        Height="620" Width="680"
        WindowStartupLocation="CenterScreen"
        ThemeMode="System"
        FontSize="13">

    <Grid Margin="16">
        <TabControl Background="Transparent" BorderThickness="0">
            
            <!-- 1. GENERAL -->
            <TabItem Header="General">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,12,0,0">
                    <StackPanel>
                        <GroupBox Header="Character Name">
                            <Grid Margin="0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Display Name:" VerticalAlignment="Center"/>
                                <TextBox Grid.Column="1" Text="{Binding CharacterName, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Display Name"/>
                            </Grid>
                        </GroupBox>

                        <GroupBox Header="Startup">
                            <StackPanel>
                                <CheckBox Content="Launch Cookie at login" IsChecked="{Binding LaunchAtLogin}"/>
                                <CheckBox Content="Show Cookie on startup" IsChecked="{Binding ShowOnStartup}"/>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="Desktop">
                            <StackPanel>
                                <CheckBox Content="Remember Cookie's desktop position" IsChecked="{Binding RememberPosition}"/>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="Accessibility">
                            <Grid Margin="0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Reduced Motion:" VerticalAlignment="Center"/>
                                <ComboBox Grid.Column="1" ItemsSource="{Binding AvailableReducedMotionModes}" SelectedItem="{Binding SelectedReducedMotion}" AutomationProperties.Name="Reduced Motion Mode"/>
                            </Grid>
                        </GroupBox>

                        <GroupBox Header="Updates">
                            <StackPanel>
                                <CheckBox Content="Automatically check for updates" IsChecked="{Binding AutomaticallyCheckForUpdates}"/>
                                <TextBlock Text="Cookie checks for updates securely. No personal data is sent." 
                                           Foreground="{DynamicResource TextMuted}" FontSize="11" Margin="0,4,0,8"/>
                                <Button Content="Check for Updates Now..." Command="{Binding CheckForUpdatesCommand}" HorizontalAlignment="Left" Padding="12,4"/>
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- 2. APPEARANCE & CUSTOMIZATION (WITH LIVE PREVIEW) -->
            <TabItem Header="Appearance">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,12,0,0">
                    <StackPanel>
                        <!-- Live Character Preview Card -->
                        <Border Background="{DynamicResource BgIvory}" BorderBrush="{DynamicResource BorderBeige}" 
                                BorderThickness="1" CornerRadius="18" Padding="14" HorizontalAlignment="Center" Margin="0,0,0,14">
                            <StackPanel HorizontalAlignment="Center">
                                <rendering:CookieCanvas x:Name="PreviewCanvas" Width="140" Height="140" HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding CharacterName}" FontSize="14" FontWeight="SemiBold" 
                                           Foreground="{DynamicResource TextCharcoal}" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>

                        <GroupBox Header="Size &amp; Scale">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="48"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Cookie Size:" VerticalAlignment="Center"/>
                                <Slider Grid.Column="1" Minimum="0.7" Maximum="1.4" Value="{Binding CookieSize}" SmallChange="0.05" AutomationProperties.Name="Cookie Size"/>
                                <TextBlock Grid.Column="2" Text="{Binding CookieSizePercent}" VerticalAlignment="Center" TextAlignment="Right" FontWeight="SemiBold"/>
                            </Grid>
                        </GroupBox>

                        <GroupBox Header="Animation">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="48"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Intensity:" VerticalAlignment="Center"/>
                                <Slider Grid.Column="1" Minimum="0.5" Maximum="1.5" Value="{Binding AnimationIntensity}" SmallChange="0.1" AutomationProperties.Name="Animation Intensity"/>
                                <TextBlock Grid.Column="2" Text="{Binding AnimationIntensityPercent}" VerticalAlignment="Center" TextAlignment="Right" FontWeight="SemiBold"/>
                            </Grid>
                        </GroupBox>

                        <GroupBox Header="Fur Color &amp; Pattern">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="Fur Color:" VerticalAlignment="Center" Margin="0,4"/>
                                <ComboBox Grid.Column="1" ItemsSource="{Binding AvailableFurColors}" SelectedItem="{Binding SelectedFurColor}" Margin="0,4"/>

                                <TextBlock Grid.Row="1" Text="Pattern:" VerticalAlignment="Center" Margin="0,4"/>
                                <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding AvailableFurPatterns}" SelectedItem="{Binding SelectedFurPattern}" Margin="0,4"/>
                            </Grid>
                        </GroupBox>

                        <GroupBox Header="Eyes">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="Eye Color:" VerticalAlignment="Center" Margin="0,4"/>
                                <ComboBox Grid.Column="1" ItemsSource="{Binding AvailableEyeColors}" SelectedItem="{Binding SelectedEyeColor}" Margin="0,4"/>

                                <TextBlock Grid.Row="1" Text="Eye Style:" VerticalAlignment="Center" Margin="0,4"/>
                                <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding AvailableEyeStyles}" SelectedItem="{Binding SelectedEyeStyle}" Margin="0,4"/>
                            </Grid>
                        </GroupBox>

                        <GroupBox Header="Ears, Tail &amp; Body">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="Ear Shape:" VerticalAlignment="Center" Margin="0,4"/>
                                <ComboBox Grid.Column="1" ItemsSource="{Binding AvailableEarVariations}" SelectedItem="{Binding SelectedEarVariation}" Margin="0,4"/>

                                <TextBlock Grid.Row="1" Text="Tail Shape:" VerticalAlignment="Center" Margin="0,4"/>
                                <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding AvailableTailVariations}" SelectedItem="{Binding SelectedTailVariation}" Margin="0,4"/>

                                <TextBlock Grid.Row="2" Text="Body Shape:" VerticalAlignment="Center" Margin="0,4"/>
                                <ComboBox Grid.Row="2" Grid.Column="1" ItemsSource="{Binding AvailableBodyVariations}" SelectedItem="{Binding SelectedBodyVariation}" Margin="0,4"/>
                            </Grid>
                        </GroupBox>

                        <GroupBox Header="Accessories">
                            <StackPanel>
                                <TextBlock Text="Toggle cute accessories that layer over Cookie:" Foreground="{DynamicResource TextMuted}" FontSize="11" Margin="0,0,0,6"/>
                                <UniformGrid Columns="3">
                                    <CheckBox Content="Collar" IsChecked="{Binding AccessoryCollar}"/>
                                    <CheckBox Content="Bow" IsChecked="{Binding AccessoryBow}"/>
                                    <CheckBox Content="Party Hat" IsChecked="{Binding AccessoryHat}"/>
                                    <CheckBox Content="Glasses" IsChecked="{Binding AccessoryGlasses}"/>
                                    <CheckBox Content="Winter Scarf" IsChecked="{Binding AccessoryScarf}"/>
                                    <CheckBox Content="Royal Crown" IsChecked="{Binding AccessoryCrown}"/>
                                    <CheckBox Content="Bandana" IsChecked="{Binding AccessoryBandana}"/>
                                    <CheckBox Content="Pumpkin" IsChecked="{Binding AccessoryPumpkin}"/>
                                    <CheckBox Content="Santa Hat" IsChecked="{Binding AccessorySantaHat}"/>
                                </UniformGrid>
                            </StackPanel>
                        </GroupBox>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,4,0,10">
                            <Button Content="Remove All Accessories" Command="{Binding RemoveAllAccessoriesCommand}" Margin="0,0,8,0"/>
                            <Button Content="Revert Appearance" Command="{Binding ResetAppearanceCommand}"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- 3. PERSONALITY -->
            <TabItem Header="Personality">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,12,0,0">
                    <StackPanel>
                        <GroupBox Header="Temperament Preset">
                            <StackPanel>
                                <ComboBox ItemsSource="{Binding AvailablePersonalities}" SelectedItem="{Binding SelectedPersonality}" Margin="0,4" AutomationProperties.Name="Temperament Preset"/>
                                <Border Background="{DynamicResource BgIvory}" BorderBrush="{DynamicResource BorderBeige}" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,6">
                                    <StackPanel>
                                        <TextBlock Text="{Binding PersonalitySummary}" FontWeight="Medium" Foreground="{DynamicResource TextCharcoal}" TextWrapping="Wrap"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                            <TextBlock Text="Strolling Speed: " Foreground="{DynamicResource TextMuted}" FontSize="11"/>
                                            <TextBlock Text="{Binding PersonalityWalkSpeed}" FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource AccentWarmOrange}" Margin="0,0,16,0"/>
                                            <TextBlock Text="Petting Tolerance: " Foreground="{DynamicResource TextMuted}" FontSize="11"/>
                                            <TextBlock Text="{Binding PersonalityPetTolerance}" FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource AccentWarmOrange}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="Activity Level">
                            <StackPanel>
                                <ComboBox ItemsSource="{Binding AvailableActivities}" SelectedItem="{Binding SelectedActivity}" Margin="0,4" AutomationProperties.Name="Activity Level"/>
                                <TextBlock Text="Controls how actively Cookie strolls or rests: Calm, Balanced, or Playful." 
                                           Foreground="{DynamicResource TextMuted}" FontSize="11" Margin="0,4,0,0"/>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="Autonomous Behavior">
                            <StackPanel>
                                <CheckBox Content="Autonomous behavior enabled" IsChecked="{Binding AutonomousBehaviorEnabled}"/>
                                <CheckBox Content="Pause autonomous wandering" IsChecked="{Binding PauseAutonomousBehavior}"/>
                                <CheckBox Content="Random interactions (stretching, grooming, yawning)" IsChecked="{Binding RandomInteractions}"/>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="Sleep Cycle">
                            <ComboBox ItemsSource="{Binding AvailableSleepBehaviors}" SelectedItem="{Binding SelectedSleepBehavior}" Margin="0,4" AutomationProperties.Name="Sleep Cycle"/>
                        </GroupBox>

                        <Button Content="Reset Personality &amp; Activity to Defaults" Command="{Binding ResetPersonalityCommand}" HorizontalAlignment="Left"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- 4. CURSOR INTERACTION -->
            <TabItem Header="Cursor">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,12,0,0">
                    <StackPanel>
                        <GroupBox Header="Awareness">
                            <StackPanel>
                                <CheckBox Content="Enable cursor interactions" IsChecked="{Binding CursorInteraction}"/>
                                <CheckBox Content="Curious cursor following" IsChecked="{Binding CursorFollowingEnabled}" IsEnabled="{Binding CursorInteraction}"/>
                                <CheckBox Content="Playful dodging when rushed" IsChecked="{Binding CursorDodgingEnabled}" IsEnabled="{Binding CursorInteraction}"/>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="Intensity">
                            <StackPanel>
                                <ComboBox ItemsSource="{Binding AvailableFollowingIntensities}" SelectedItem="{Binding SelectedFollowingIntensity}" 
                                           IsEnabled="{Binding CursorInteraction}" Margin="0,4" AutomationProperties.Name="Following Intensity"/>
                                <TextBlock Text="Sets how closely and quickly Cookie glances toward or steps near the cursor." 
                                           Foreground="{DynamicResource TextMuted}" FontSize="11" Margin="0,4,0,0"/>
                            </StackPanel>
                        </GroupBox>

                        <Button Content="Reset Cursor Settings to Defaults" Command="{Binding ResetCursorCommand}" HorizontalAlignment="Left"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- 5. DESKTOP EXPLORATION -->
            <TabItem Header="Exploration">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,12,0,0">
                    <StackPanel>
                        <GroupBox Header="Taskbar Exploration">
                            <StackPanel>
                                <CheckBox Content="Taskbar interaction enabled" IsChecked="{Binding DockInteraction}"/>
                                <CheckBox Content="Autonomous taskbar exploration" IsChecked="{Binding AutonomousDockExploration}" IsEnabled="{Binding DockInteraction}"/>
                                <Grid Margin="0,6,0,0" IsEnabled="{Binding DockInteraction}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Exploration Frequency:" VerticalAlignment="Center"/>
                                    <ComboBox Grid.Column="1" ItemsSource="{Binding AvailableDockExplorationFrequencies}" SelectedItem="{Binding SelectedDockExplorationFrequency}" AutomationProperties.Name="Taskbar Exploration Frequency"/>
                                </Grid>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="Window Exploration">
                            <StackPanel>
                                <CheckBox Content="Window edge exploration enabled" IsChecked="{Binding WindowInteraction}"/>
                                <CheckBox Content="Enable vertical window climbing" IsChecked="{Binding WindowVerticalClimbing}" IsEnabled="{Binding WindowInteraction}"/>
                                <Grid Margin="0,6,0,0" IsEnabled="{Binding WindowInteraction}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Exploration Frequency:" VerticalAlignment="Center"/>
                                    <ComboBox Grid.Column="1" ItemsSource="{Binding AvailableWindowExplorationFrequencies}" SelectedItem="{Binding SelectedWindowExplorationFrequency}" AutomationProperties.Name="Window Exploration Frequency"/>
                                </Grid>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="Window-to-Window Jumping">
                            <StackPanel>
                                <CheckBox Content="Enable surface &amp; window jumping" IsChecked="{Binding WindowJumpingEnabled}" IsEnabled="{Binding WindowInteraction}"/>
                                <Grid Margin="0,6,0,0" IsEnabled="{Binding WindowJumpingEnabled}">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Text="Jump Frequency:" VerticalAlignment="Center" Margin="0,4"/>
                                    <ComboBox Grid.Column="1" ItemsSource="{Binding AvailableJumpFrequencies}" SelectedItem="{Binding SelectedJumpFrequency}" Margin="0,4" AutomationProperties.Name="Jump Frequency"/>

                                    <TextBlock Grid.Row="1" Text="Jump Style:" VerticalAlignment="Center" Margin="0,4"/>
                                    <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding AvailableJumpStyles}" SelectedItem="{Binding SelectedJumpStyle}" Margin="0,4" AutomationProperties.Name="Jump Style"/>
                                </Grid>
                            </StackPanel>
                        </GroupBox>

                        <Button Content="Reset Exploration Settings to Defaults" Command="{Binding ResetExplorationCommand}" HorizontalAlignment="Left" Margin="0,8,0,0"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- 6. SOUNDS -->
            <TabItem Header="Sounds">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,12,0,0">
                    <StackPanel>
                        <GroupBox Header="Master Audio">
                            <StackPanel>
                                <CheckBox Content="Enable all sounds" IsChecked="{Binding SoundEnabled}"/>
                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="48"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Master Volume:" VerticalAlignment="Center"/>
                                    <Slider Grid.Column="1" Minimum="0.0" Maximum="1.0" Value="{Binding MasterVolume}" IsEnabled="{Binding SoundEnabled}" AutomationProperties.Name="Master Volume"/>
                                    <TextBlock Grid.Column="2" Text="{Binding MasterVolumePercent}" VerticalAlignment="Center" TextAlignment="Right" FontWeight="SemiBold"/>
                                </Grid>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="Vocalizations">
                            <StackPanel>
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="48"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Meow Volume:" VerticalAlignment="Center"/>
                                    <Slider Grid.Column="1" Minimum="0.0" Maximum="1.0" Value="{Binding MeowVolume}" IsEnabled="{Binding SoundEnabled}" AutomationProperties.Name="Meow Volume"/>
                                    <TextBlock Grid.Column="2" Text="{Binding MeowVolumePercent}" VerticalAlignment="Center" TextAlignment="Right" FontWeight="SemiBold"/>
                                </Grid>
                                <CheckBox Content="Play interaction sounds (chirp, toy, boop)" IsChecked="{Binding InteractionSounds}" IsEnabled="{Binding SoundEnabled}"/>
                                <CheckBox Content="Play purring sounds when pet" IsChecked="{Binding PurringSounds}" IsEnabled="{Binding SoundEnabled}"/>
                            </StackPanel>
                        </GroupBox>

                        <Button Content="Test Sound" Command="{Binding TestSoundCommand}" HorizontalAlignment="Left" IsEnabled="{Binding SoundEnabled}"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- 7. STATS -->
            <TabItem Header="Stats">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,12,0,0">
                    <StackPanel>
                        <GroupBox Header="Time Together">
                            <StackPanel>
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Days together" Foreground="{DynamicResource TextMuted}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Statistics.DaysTogetherToday}" FontWeight="SemiBold"/>
                                </Grid>
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="First met" Foreground="{DynamicResource TextMuted}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Statistics.FirstMetDisplay}" FontWeight="SemiBold"/>
                                </Grid>
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Launches" Foreground="{DynamicResource TextMuted}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Statistics.LaunchCount}" FontWeight="SemiBold"/>
                                </Grid>
                            </StackPanel>
                        </GroupBox>
                        <GroupBox Header="Affection">
                            <StackPanel>
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Times petted" Foreground="{DynamicResource TextMuted}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Statistics.PetsReceived}" FontWeight="SemiBold"/>
                                </Grid>
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Affection" Foreground="{DynamicResource TextMuted}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Statistics.Affection}" FontWeight="SemiBold"/>
                                </Grid>
                            </StackPanel>
                        </GroupBox>
                        <GroupBox Header="Care &amp; Play">
                            <StackPanel>
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Total interactions" Foreground="{DynamicResource TextMuted}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Statistics.TotalInteractions}" FontWeight="SemiBold"/>
                                </Grid>
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Treats given" Foreground="{DynamicResource TextMuted}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Statistics.TreatsGiven}" FontWeight="SemiBold"/>
                                </Grid>
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Toys played with" Foreground="{DynamicResource TextMuted}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Statistics.ToysPlayedWith}" FontWeight="SemiBold"/>
                                </Grid>
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Cardboard box visits" Foreground="{DynamicResource TextMuted}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Statistics.BoxVisits}" FontWeight="SemiBold"/>
                                </Grid>
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Favorite toy" Foreground="{DynamicResource TextMuted}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Statistics.FavoriteToyDisplay}" FontWeight="SemiBold"/>
                                </Grid>
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
