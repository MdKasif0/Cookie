<Window x:Class="Cookie.Windows.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cookie Settings"
        Height="540" Width="600"
        WindowStartupLocation="CenterScreen"
        Background="#FDFBF7"
        Foreground="#2D2A26"
        FontFamily="Segoe UI"
        FontSize="13">

    <Window.Resources>
        <!-- Palette Brushes -->
        <SolidColorBrush x:Key="BgWarmCream" Color="#FDFBF7"/>
        <SolidColorBrush x:Key="BgIvory" Color="#F5EFEB"/>
        <SolidColorBrush x:Key="BorderBeige" Color="#E8DFD1"/>
        <SolidColorBrush x:Key="AccentWarmOrange" Color="#E08744"/>
        <SolidColorBrush x:Key="AccentCaramel" Color="#C67A38"/>
        <SolidColorBrush x:Key="TextCharcoal" Color="#2D2A26"/>
        <SolidColorBrush x:Key="TextMuted" Color="#75726D"/>
        <SolidColorBrush x:Key="MutedSage" Color="#8A9A86"/>

        <Style TargetType="TabItem">
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBorder" BorderThickness="0,0,0,2" BorderBrush="Transparent" Background="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="{StaticResource AccentWarmOrange}"/>
                                <Setter Property="Foreground" Value="{StaticResource TextCharcoal}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource AccentCaramel}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="0,0,0,14"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBeige}"/>
            <Setter Property="Padding" Value="12"/>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextCharcoal}"/>
            <Setter Property="Margin" Value="0,6"/>
        </Style>

        <Style TargetType="Slider">
            <Setter Property="Margin" Value="8,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Background" Value="{StaticResource BgIvory}"/>
            <Setter Property="Foreground" Value="{StaticResource TextCharcoal}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBeige}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Margin" Value="0,4"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <TabControl Background="Transparent" BorderThickness="0">
            
            <!-- 1. GENERAL -->
            <TabItem Header="General">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,12,0,0">
                    <StackPanel>
                        <GroupBox Header="Startup">
                            <StackPanel>
                                <CheckBox Content="Launch Cookie at login" IsChecked="{Binding LaunchAtLogin}"/>
                                <CheckBox Content="Show Cookie on startup" IsChecked="{Binding ShowOnStartup}"/>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="Desktop">
                            <StackPanel>
                                <CheckBox Content="Remember Cookie's desktop position" IsChecked="{Binding RememberPosition}"/>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="Updates">
                            <StackPanel>
                                <CheckBox Content="Automatically check for updates" IsChecked="{Binding AutomaticallyCheckForUpdates}"/>
                                <TextBlock Text="Cookie checks for updates securely. No personal data is sent." 
                                           Foreground="{StaticResource TextMuted}" FontSize="11" Margin="0,4,0,0"/>
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- 2. APPEARANCE -->
            <TabItem Header="Appearance">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,12,0,0">
                    <StackPanel>
                        <GroupBox Header="Size &amp; Scale">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="48"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Cookie Size:" VerticalAlignment="Center"/>
                                <Slider Grid.Column="1" Minimum="0.7" Maximum="1.4" Value="{Binding CookieSize}" SmallChange="0.05"/>
                                <TextBlock Grid.Column="2" Text="{Binding CookieSizePercent}" VerticalAlignment="Center" TextAlignment="Right" FontWeight="SemiBold"/>
                            </Grid>
                        </GroupBox>

                        <GroupBox Header="Animation">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="48"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Intensity:" VerticalAlignment="Center"/>
                                <Slider Grid.Column="1" Minimum="0.5" Maximum="1.5" Value="{Binding AnimationIntensity}" SmallChange="0.1"/>
                                <TextBlock Grid.Column="2" Text="{Binding AnimationIntensityPercent}" VerticalAlignment="Center" TextAlignment="Right" FontWeight="SemiBold"/>
                            </Grid>
                        </GroupBox>

                        <GroupBox Header="Fur Color">
                            <ComboBox ItemsSource="{Binding AvailableFurColors}" SelectedItem="{Binding SelectedFurColor}" Margin="0,4"/>
                        </GroupBox>

                        <GroupBox Header="Eye Color">
                            <ComboBox ItemsSource="{Binding AvailableEyeColors}" SelectedItem="{Binding SelectedEyeColor}" Margin="0,4"/>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- 3. PERSONALITY -->
            <TabItem Header="Personality">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,12,0,0">
                    <StackPanel>
                        <GroupBox Header="Activity Level">
                            <StackPanel>
                                <ComboBox ItemsSource="{Binding AvailableActivities}" SelectedItem="{Binding SelectedActivity}" Margin="0,4"/>
                                <TextBlock Text="Controls how actively Cookie strolls or rests: Calm, Balanced, or Playful." 
                                           Foreground="{StaticResource TextMuted}" FontSize="11" Margin="0,4,0,0"/>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="Autonomous Behavior">
                            <StackPanel>
                                <CheckBox Content="Autonomous behavior enabled" IsChecked="{Binding AutonomousBehaviorEnabled}"/>
                                <CheckBox Content="Pause autonomous wandering" IsChecked="{Binding PauseAutonomousBehavior}"/>
                                <CheckBox Content="Random interactions (stretching, grooming, yawning)" IsChecked="{Binding RandomInteractions}"/>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="Sleep Cycle">
                            <ComboBox ItemsSource="{Binding AvailableSleepBehaviors}" SelectedItem="{Binding SelectedSleepBehavior}" Margin="0,4"/>
                        </GroupBox>

                        <Button Content="Reset Personality &amp; Activity to Defaults" Command="{Binding ResetPersonalityCommand}" HorizontalAlignment="Left"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- 4. CURSOR INTERACTION -->
            <TabItem Header="Cursor">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,12,0,0">
                    <StackPanel>
                        <GroupBox Header="Awareness">
                            <StackPanel>
                                <CheckBox Content="Enable cursor interactions" IsChecked="{Binding CursorInteraction}"/>
                                <CheckBox Content="Curious cursor following" IsChecked="{Binding CursorFollowingEnabled}" IsEnabled="{Binding CursorInteraction}"/>
                                <CheckBox Content="Playful dodging when rushed" IsChecked="{Binding CursorDodgingEnabled}" IsEnabled="{Binding CursorInteraction}"/>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="Intensity">
                            <StackPanel>
                                <ComboBox ItemsSource="{Binding AvailableFollowingIntensities}" SelectedItem="{Binding SelectedFollowingIntensity}" 
                                          IsEnabled="{Binding CursorInteraction}" Margin="0,4"/>
                                <TextBlock Text="Sets how closely and quickly Cookie glances toward or steps near the cursor." 
                                           Foreground="{StaticResource TextMuted}" FontSize="11" Margin="0,4,0,0"/>
                            </StackPanel>
                        </GroupBox>

                        <Button Content="Reset Cursor Settings to Defaults" Command="{Binding ResetCursorCommand}" HorizontalAlignment="Left"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- 5. DESKTOP EXPLORATION -->
            <TabItem Header="Exploration">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,12,0,0">
                    <StackPanel>
                        <GroupBox Header="Taskbar &amp; Surfaces">
                            <StackPanel>
                                <CheckBox Content="Taskbar interaction enabled" IsChecked="{Binding DockInteraction}"/>
                                <CheckBox Content="Autonomous taskbar exploration" IsChecked="{Binding AutonomousDockExploration}" IsEnabled="{Binding DockInteraction}"/>
                                <CheckBox Content="Window edge exploration" IsChecked="{Binding WindowInteraction}"/>
                                <CheckBox Content="Window-to-window jumping" IsChecked="{Binding WindowJumpingEnabled}" IsEnabled="{Binding WindowInteraction}"/>
                            </StackPanel>
                        </GroupBox>

                        <Button Content="Reset Exploration Settings to Defaults" Command="{Binding ResetExplorationCommand}" HorizontalAlignment="Left"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- 6. SOUNDS -->
            <TabItem Header="Sounds">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,12,0,0">
                    <StackPanel>
                        <GroupBox Header="Master Audio">
                            <StackPanel>
                                <CheckBox Content="Enable all sounds" IsChecked="{Binding SoundEnabled}"/>
                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="48"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Master Volume:" VerticalAlignment="Center"/>
                                    <Slider Grid.Column="1" Minimum="0.0" Maximum="1.0" Value="{Binding MasterVolume}" IsEnabled="{Binding SoundEnabled}"/>
                                    <TextBlock Grid.Column="2" Text="{Binding MasterVolumePercent}" VerticalAlignment="Center" TextAlignment="Right" FontWeight="SemiBold"/>
                                </Grid>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="Vocalizations">
                            <StackPanel>
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="48"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Meow Volume:" VerticalAlignment="Center"/>
                                    <Slider Grid.Column="1" Minimum="0.0" Maximum="1.0" Value="{Binding MeowVolume}" IsEnabled="{Binding SoundEnabled}"/>
                                    <TextBlock Grid.Column="2" Text="{Binding MeowVolumePercent}" VerticalAlignment="Center" TextAlignment="Right" FontWeight="SemiBold"/>
                                </Grid>
                                <CheckBox Content="Interaction sounds (pet, drop, hello)" IsChecked="{Binding InteractionSounds}" IsEnabled="{Binding SoundEnabled}"/>
                                <CheckBox Content="Purring &amp; ambient resting sounds" IsChecked="{Binding PurringSounds}" IsEnabled="{Binding SoundEnabled}"/>
                                <Button Content="Test Vocalization (Meow)" Command="{Binding TestSoundCommand}" HorizontalAlignment="Left" Margin="0,8,0,0"/>
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- 7. ACCESSIBILITY -->
            <TabItem Header="Accessibility">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,12,0,0">
                    <StackPanel>
                        <GroupBox Header="Motion">
                            <StackPanel>
                                <ComboBox ItemsSource="{Binding AvailableReducedMotionModes}" SelectedItem="{Binding SelectedReducedMotion}" Margin="0,4"/>
                                <TextBlock Text="When reduced, Cookie holds calm poses instead of rapid walking — transitions remain smooth." 
                                           Foreground="{StaticResource TextMuted}" FontSize="11" Margin="0,4,0,0"/>
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- 8. ABOUT -->
            <TabItem Header="About">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,12,0,0">
                    <StackPanel>
                        <GroupBox Header="Cookie for Windows">
                            <StackPanel>
                                <TextBlock Text="Cookie Desktop Companion" FontWeight="Bold" FontSize="15" Margin="0,0,0,4"/>
                                <TextBlock Text="Version 1.1.0 (Windows Native Edition)" Foreground="{StaticResource TextMuted}" Margin="0,0,0,2"/>
                                <TextBlock Text="Category: Desktop Companion" Foreground="{StaticResource TextMuted}" Margin="0,0,0,4"/>
                                <TextBlock Text="A tiny desktop companion designed to feel like a carefully crafted companion on your Windows desktop." 
                                           TextWrapping="Wrap" Margin="0,8,0,4"/>
                                <TextBlock Text="{Binding CopyrightText}" Foreground="{StaticResource TextMuted}" FontSize="11" Margin="0,6,0,0"/>
                            </StackPanel>
                        </GroupBox>
                        <GroupBox Header="Privacy">
                            <StackPanel>
                                <TextBlock Text="• Everything works locally on your PC." Margin="0,2"/>
                                <TextBlock Text="• No account or sign-in required." Margin="0,2"/>
                                <TextBlock Text="• No analytics, telemetry, or cloud tracking." Margin="0,2"/>
                                <TextBlock Text="• Settings are saved locally in %AppData%\Cookie." Margin="0,2"/>
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

        </TabControl>
    </Grid>
</Window>
