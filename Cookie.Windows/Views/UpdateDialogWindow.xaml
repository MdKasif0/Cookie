<Window x:Class="Cookie.Windows.Views.UpdateDialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Software Update"
        Height="440" Width="480"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        ThemeMode="System"
        FontSize="13">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock x:Name="StatusTitleText" Text="Checking for Updates..." FontSize="18" FontWeight="Bold" 
                       Foreground="{DynamicResource TextCharcoal}"/>
            <TextBlock x:Name="StatusSubtitleText" Text="Connecting securely to update server..." FontSize="12" 
                       Foreground="{DynamicResource TextMuted}" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Body / Release Details -->
        <Border Grid.Row="1" Background="{DynamicResource BgIvory}" BorderBrush="{DynamicResource BorderBeige}" 
                BorderThickness="1" CornerRadius="12" Padding="14">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock x:Name="DetailsHeadingText" Text="Release Notes" FontWeight="SemiBold" 
                               Foreground="{DynamicResource TextCharcoal}" Margin="0,0,0,6"/>
                    <TextBlock x:Name="ReleaseNotesText" Text="Looking for newer releases..." 
                               TextWrapping="Wrap" Foreground="{DynamicResource TextMuted}" LineHeight="18"/>
                    
                    <!-- Progress Bar when downloading -->
                    <StackPanel x:Name="ProgressPanel" Visibility="Collapsed" Margin="0,16,0,0">
                        <TextBlock x:Name="ProgressText" Text="Downloading update package... 0%" FontSize="12" 
                                   Foreground="{DynamicResource TextCharcoal}" Margin="0,0,0,6"/>
                        <ProgressBar x:Name="DownloadProgressBar" Minimum="0" Maximum="100" Value="0"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Footer Buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="ActionBtn" Content="Install &amp; Restart" Click="ActionBtn_Click" 
                    Style="{DynamicResource AccentButtonStyle}" FontWeight="SemiBold" 
                    Visibility="Collapsed" AutomationProperties.Name="Install and Restart"/>
            <Button x:Name="CloseBtn" Content="Close" Click="CloseBtn_Click" IsCancel="True" AutomationProperties.Name="Close Update Window"/>
        </StackPanel>
    </Grid>
</Window>
