<Window x:Class="Cookie.Windows.Views.OnboardingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:rendering="clr-namespace:Cookie.Windows.Rendering"
        Title="Welcome to Cookie"
        Height="660" Width="560"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#FDFBF7"
        Foreground="#2D2A26"
        FontFamily="Segoe UI"
        FontSize="13">

    <Window.Resources>
        <!-- Palette Brushes -->
        <SolidColorBrush x:Key="BgWarmCream" Color="#FDFBF7"/>
        <SolidColorBrush x:Key="BgIvory" Color="#F5EFEB"/>
        <SolidColorBrush x:Key="BorderBeige" Color="#E8DFD1"/>
        <SolidColorBrush x:Key="AccentWarmOrange" Color="#E08744"/>
        <SolidColorBrush x:Key="AccentCaramel" Color="#C67A38"/>
        <SolidColorBrush x:Key="TextCharcoal" Color="#2D2A26"/>
        <SolidColorBrush x:Key="TextMuted" Color="#75726D"/>
        <SolidColorBrush x:Key="MutedSage" Color="#8A9A86"/>

        <Style TargetType="Button">
            <Setter Property="Background" Value="{StaticResource BgIvory}"/>
            <Setter Property="Foreground" Value="{StaticResource TextCharcoal}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBeige}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,0,0,16">
            <TextBlock Text="Meet Cookie 🍪" FontSize="24" FontWeight="Bold" Foreground="{StaticResource TextCharcoal}" 
                       HorizontalAlignment="Center" Margin="0,0,0,4"/>
            <TextBlock Text="Your small, intelligent desktop companion is ready to explore." FontSize="13" 
                       Foreground="{StaticResource TextMuted}" HorizontalAlignment="Center"/>
        </StackPanel>

        <!-- Main Content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,16">
            <StackPanel>
                <!-- Character Preview Card -->
                <Border Background="{StaticResource BgIvory}" BorderBrush="{StaticResource BorderBeige}" 
                        BorderThickness="1" CornerRadius="16" Padding="14" HorizontalAlignment="Center" Margin="0,0,0,16">
                    <StackPanel HorizontalAlignment="Center">
                        <rendering:CookieCanvas x:Name="OnboardingCanvas" Width="130" Height="130" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Feature Tips -->
                <Border Background="{StaticResource BgIvory}" BorderBrush="{StaticResource BorderBeige}" 
                        BorderThickness="1" CornerRadius="12" Padding="14" Margin="0,0,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="36"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="🐾" FontSize="20" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                            <TextBlock Text="Direct Interaction &amp; Dragging" FontWeight="SemiBold" Foreground="{StaticResource TextCharcoal}"/>
                            <TextBlock Text="Click and drag Cookie to pick up and move anywhere on your screens. Click to pet and hear a gentle purr!" 
                                       TextWrapping="Wrap" Foreground="{StaticResource TextMuted}" FontSize="12" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Background="{StaticResource BgIvory}" BorderBrush="{StaticResource BorderBeige}" 
                        BorderThickness="1" CornerRadius="12" Padding="14" Margin="0,0,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="36"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="🎨" FontSize="20" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                            <TextBlock Text="Emotes &amp; Expressions" FontWeight="SemiBold" Foreground="{StaticResource TextCharcoal}"/>
                            <TextBlock Text="Right-click Cookie or use the notification area tray icon to trigger fun emotes like Wave, Love, and Sleepy." 
                                       TextWrapping="Wrap" Foreground="{StaticResource TextMuted}" FontSize="12" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Background="{StaticResource BgIvory}" BorderBrush="{StaticResource BorderBeige}" 
                        BorderThickness="1" CornerRadius="12" Padding="14" Margin="0,0,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="36"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="🪟" FontSize="20" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                            <TextBlock Text="Window &amp; Taskbar Exploration" FontWeight="SemiBold" Foreground="{StaticResource TextCharcoal}"/>
                            <TextBlock Text="Cookie explores open windows, climbs window headers, and visits the taskbar naturally without disrupting your work." 
                                       TextWrapping="Wrap" Foreground="{StaticResource TextMuted}" FontSize="12" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Background="{StaticResource BgIvory}" BorderBrush="{StaticResource BorderBeige}" 
                        BorderThickness="1" CornerRadius="12" Padding="14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="36"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="⏸️" FontSize="20" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                            <TextBlock Text="Full User Control &amp; Privacy" FontWeight="SemiBold" Foreground="{StaticResource TextCharcoal}"/>
                            <TextBlock Text="Need quiet focus? Easily pause autonomous movement via the tray menu. Cookie never logs activity or collects data." 
                                       TextWrapping="Wrap" Foreground="{StaticResource TextMuted}" FontSize="12" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Footer -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button x:Name="CustomizeBtn" Content="Customize Appearance..." Click="CustomizeBtn_Click" 
                    HorizontalAlignment="Left" AutomationProperties.Name="Customize Appearance"/>

            <Button x:Name="GetStartedBtn" Grid.Column="1" Content="Get Started" Click="GetStartedBtn_Click" 
                    Background="{StaticResource AccentWarmOrange}" Foreground="White" FontWeight="SemiBold" 
                    IsDefault="True" Padding="20,8" AutomationProperties.Name="Get Started with Cookie"/>
        </Grid>
    </Grid>
</Window>
