<Window x:Class="Cookie.Windows.Views.OnboardingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:rendering="clr-namespace:Cookie.Windows.Rendering"
        Title="Welcome to Cookie"
        Height="760" Width="500"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        ThemeMode="System"
        FontSize="13">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="232"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Cookie's stage -->
        <Border Background="{DynamicResource StageBackground}" ClipToBounds="True">
            <Canvas x:Name="Stage">
                <Ellipse x:Name="FloorShadow" Width="180" Height="22" Canvas.Left="120" Canvas.Top="204"
                         Fill="{DynamicResource StageFloor}" Opacity="0">
                    <Ellipse.Effect>
                        <BlurEffect Radius="12"/>
                    </Ellipse.Effect>
                </Ellipse>
                <rendering:CookieCanvas x:Name="StageCat" Width="194" Height="194" Canvas.Top="30"/>
                <Border x:Name="SpeechBubble" Canvas.Left="316" Canvas.Top="36" MaxWidth="168"
                        Background="{DynamicResource BgWarmWhite}" BorderBrush="{DynamicResource BorderSubtle}"
                        BorderThickness="1" CornerRadius="14" Padding="12,8" Opacity="0">
                    <TextBlock x:Name="SpeechText" FontWeight="SemiBold" TextWrapping="Wrap" TextAlignment="Center"
                               Foreground="{DynamicResource TextCharcoal}"/>
                </Border>
            </Canvas>
        </Border>

        <!-- Name and personality -->
        <Grid Grid.Row="1" Margin="24,16,24,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel>
                <TextBlock Text="What's her name?" HorizontalAlignment="Center" Margin="0,0,0,6"
                           Foreground="{DynamicResource TextMuted}"/>
                <TextBox x:Name="NameBox" FontSize="20" FontWeight="Bold" TextAlignment="Center" MaxLength="24"
                         TextChanged="NameBox_TextChanged" AutomationProperties.Name="Cookie's name"/>
            </StackPanel>

            <UniformGrid x:Name="PersonalityGrid" Grid.Row="1" Columns="3" Rows="2" Margin="-4,14,-4,6"/>

            <TextBlock x:Name="SummaryText" Grid.Row="2" HorizontalAlignment="Center" TextWrapping="Wrap"
                       TextAlignment="Center" Foreground="{DynamicResource TextMuted}" Margin="0,4,0,0"/>

            <Grid Grid.Row="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="CustomizeBtn" Content="Customize..." Click="CustomizeBtn_Click" Margin="0,0,10,0"
                        AutomationProperties.Name="Customize Appearance"/>
                <Button x:Name="GetStartedBtn" Grid.Column="1" Click="GetStartedBtn_Click" IsDefault="True"
                        Style="{DynamicResource AccentButtonStyle}" FontWeight="SemiBold" HorizontalAlignment="Stretch"
                        Padding="20,8" AutomationProperties.Name="Finish setup and start Cookie"/>
            </Grid>
        </Grid>
    </Grid>
</Window>
