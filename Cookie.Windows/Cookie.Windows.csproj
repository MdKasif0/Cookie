<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <!-- WPF's Fluent ThemeMode API is still flagged experimental. -->
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Resources\Cookie.ico</ApplicationIcon>
    <RootNamespace>Cookie.Windows</RootNamespace>
    <AssemblyName>Cookie</AssemblyName>
    
    <!-- Application Metadata -->
    <Product>Cookie</Product>
    <Title>Cookie</Title>
    <Company>Cookie Desktop Companion</Company>
    <Description>Cookie Desktop Companion for Windows</Description>
    <Version>1.1.0</Version>
    <AssemblyVersion>1.1.0.0</AssemblyVersion>
    <FileVersion>1.1.0.0</FileVersion>
    <Copyright>© 2026 Md Kasif Uddin. All rights reserved.</Copyright>
    
    <!-- Build Configurations -->
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)'=='Debug'">
    <DefineConstants>DEBUG;TRACE</DefineConstants>
    <Optimize>false</Optimize>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)'=='Release'">
    <DefineConstants>TRACE</DefineConstants>
    <Optimize>true</Optimize>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Cookie.Windows.Core\Cookie.Windows.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Link Original Audio Resources from Shared Location -->
    <Content Include="..\Cookie\Resources\Sounds\*.wav" Link="Resources\Sounds\%(Filename)%(Extension)">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- Sprite sheets shared with macOS, plus Windows-only sheets. See scripts/generate_sprites.py. -->
    <Content Include="..\Cookie\Resources\Sprites\Cookie\**\*.png;..\Cookie\Resources\Sprites\Cookie\**\*.json" Link="Resources\Sprites\Cookie\%(RecursiveDir)%(Filename)%(Extension)">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Resources\Sprites\Cookie\**\*.png;Resources\Sprites\Cookie\**\*.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- Assets Manifest -->
    <Content Include="Resources\AssetManifest.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Resources\Cookie.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Resources\CookieTray.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
